<refentry version="5.1"
  xml:id="Api.SilikoVersionPrereleaseSuffix"
  xmlns="http://docbook.org/ns/docbook">
<refmeta>
  <refentrytitle>SilikoVersionPrereleaseSuffix</refentrytitle>
</refmeta>

<refnamediv>
  <refname><varname>SilikoVersionPrereleaseSuffix</varname></refname>
  <refpurpose>String holding prerelease version suffix</refpurpose>
</refnamediv>

<refsynopsisdiv>
<programlisting language="C">#include &lt;SilikoCore/Version.h&gt;</programlisting>
<programlisting language="C">extern const char SilikoVersionPrereleaseSuffix[];</programlisting>
</refsynopsisdiv>

<refsection>
<title>Description</title>
<para>The <varname>SilikoVersionPrereleaseSuffix</varname> value
holds a suffix indicating a prerelease version.
<varname>SilikoVersionPrereleaseSuffix</varname> is an empty string in
official releases.</para>
</refsection>
</refentry>
